# Safe, deterministic default for rehearsals and offline demos.
MODEL_PROVIDER=fixture

# For the live model, copy this file to .env and set:
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-luna

# Twilio inbound — two mutually exclusive ways to receive audience texts.
#
# Option A: API polling (no public URL, outbound calls only). Best for a
# locked-down/work laptop that cannot expose a webhook. Activates when
# TWILIO_NUMBER is set. Credentials prefer an API key (Console > Account >
# API keys & tokens) and fall back to TWILIO_AUTH_TOKEN.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=...
# TWILIO_NUMBER=+15551234567
# TWILIO_POLL_SECONDS=4
#
# Option B: signed inbound webhook. Requires a public URL that Twilio can POST
# to. All three are required together and the URL must exactly match the one
# configured in the Twilio Console.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WEBHOOK_URL=https://demo.example/webhooks/twilio/messages

# Bound the number of Workflows/model calls accepted in one dashboard session.
MAX_SUBMISSIONS_PER_SESSION=20

# Unsafe opt-in for a trusted/rehearsed audience: show exact incoming text on
# the projector and persist it in the Stage volume. Leave false for public SMS.
SHOW_RAW_CONFESSIONS=false

# Second confirmation required if raw mode and Twilio are both enabled.
ALLOW_UNMODERATED_TWILIO=false

# Optional: words to blank out on the projected feed when raw mode is on.
# Comma- or space-separated, case-insensitive, whole-word match. No list is
# bundled in the repo; supply your own here (this file is git-ignored once you
# copy it to .env). Example:
# MASK_WORDS=word1, word2, word3
